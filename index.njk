---
layout: base.njk
permalink: /index.html
---
{% set essays = collections.article | reverse %}
<div class="hero">
  <div class="wrap hero-grid">
    <div class="sheet">
      <h1 class="statement">{{ site.hero_title }}</h1>
      <p class="standfirst">{{ site.hero_subtitle }}</p>
    </div>
    {% if essays.length > 0 %}
    <article class="sheet issue-card">
      <p class="issue-meta">Latest essay</p>
      <h2><a href="{{ essays[0].url }}">{{ essays[0].data.title }}</a></h2>
      <p class="byline">{{ essays[0].data.author }}</p>
      <p class="dek">{{ essays[0].data.summary }}</p>
    </article>
    {% else %}
    <article class="sheet issue-card">
      <p class="issue-meta">Coming soon</p>
      <h2>The first essay is on its way</h2>
      <p class="dek">Nothing has been published yet — add one from the editor panel at /admin.</p>
    </article>
    {% endif %}
  </div>
</div>

<section id="issue">
  <div class="wrap sheet">
    <div class="sec-head">
      <h2>Latest essays</h2>
      <p>{{ site.issue_note }}</p>
    </div>

    {% if essays.length > 0 %}
    <ul class="index">
      {% for essay in essays %}
      <li>
        <h3><a href="{{ essay.url }}">{{ essay.data.title }}</a></h3>
        <p class="byline">{{ essay.data.author }}</p>
        <p class="dek">{{ essay.data.summary }}</p>
      </li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="empty">No essays published yet. Once one is added through the editor panel at <code>/admin</code>, it will appear here automatically.</p>
    {% endif %}
  </div>
</section>

<section id="review">
  <div class="wrap sheet">
    <div class="sec-head">
      <h2>How review works</h2>
      <p>Names are removed before a piece reaches its readers</p>
    </div>
    <ol class="flow">
      <li><div><h3>Send the piece</h3><p>Upload a Google Doc or Word file through the submission form. You give a title and a short summary — no subject category to pick, write on anything with a real argument in it.</p></div></li>
      <li><div><h3>A coordinating editor checks fit</h3><p>Within a week you hear whether the piece is going forward to review, needs reshaping first, or isn't a fit. Desk rejections come with reasons.</p></div></li>
      <li><div><h3>Two students read it blind</h3><p>Your name comes off the file before two readers see it. They comment directly in the document and write a short recommendation.</p></div></li>
      <li><div><h3>You revise</h3><p>You get both sets of comments together, with the editor's summary of what has to change versus what's a suggestion. Two weeks to revise, extendable if you ask.</p></div></li>
      <li><div><h3>Copy-edit and publication</h3><p>An editor adds your essay through the editor panel — no code, just a form — and it goes live and appears in the list above automatically.</p></div></li>
    </ol>
  </div>
</section>

<section id="board">
  <div class="wrap sheet">
    <div class="sec-head">
      <h2>Editorial board</h2>
      <p>Rotates every academic year</p>
    </div>
    <div class="board">
      {% for member in site.board %}
      <div><strong>{{ member.name }}</strong><span>{{ member.role }}</span></div>
      {% endfor %}
    </div>
  </div>
</section>

<section id="submit">
  <div class="wrap sheet">
    <div class="sec-head">
      <h2>Submit an essay</h2>
      <p>Open to all MA and MPhil students at JNU, on any sociological subject</p>
    </div>
    <div class="submit-grid">
      <div>
        <p>{{ site.submit_intro_1 }}</p>
        <p>{{ site.submit_intro_2 }}</p>
        <a class="cta" href="#">Open the submission form</a>
      </div>
      <div>
        <ul class="specs">
          {% for spec in site.submit_specs %}
          <li><b>{{ spec.label }}</b> {{ spec.value }}</li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>

---
layout: base.njk
permalink: /index.html
---
{% set essays = collections.article | reverse %}
{% set recentEssays = essays | recentOnly %}
<div class="hero">
  <div class="wrap hero-grid">
    <div class="sheet">
      <h1 class="statement">{{ site.hero_title }}</h1>
      <p class="standfirst">{{ site.hero_subtitle }}</p>
    </div>
    {% if essays.length > 0 %}
    <article class="sheet issue-card">
      <p class="issue-meta">Latest essay</p>
      <h2><a href="{{ essays[0].url | url }}">{{ essays[0].data.title }}</a></h2>
      <p class="byline">{{ essays[0].data.author }}</p>
      <p class="dek">{{ essays[0].data.summary }}</p>
    </article>
    {% else %}
    <article class="sheet issue-card">
      <p class="issue-meta">Coming soon</p>
      <h2>{{ site.issue_empty_title }}</h2>
      <p class="dek">{{ site.issue_empty_text }}</p>
    </article>
    {% endif %}
  </div>
</div>

<section id="search">
  <div class="wrap sheet">
    <div class="sec-head">
      <h2>Search essays</h2>
      <p id="search-count"></p>
    </div>
    <div class="search-controls">
      <input id="search-box" type="text" placeholder="Search by title, author, theme, or keyword…">
      <select id="search-author"><option>All authors</option></select>
      <select id="search-theme"><option>All themes</option></select>
      <label>From <input id="search-from" type="date"></label>
      <label>To <input id="search-to" type="date"></label>
    </div>
    <div id="search-results"></div>
  </div>
</section>

<section id="issue">
  <div class="wrap sheet">
    <div class="sec-head">
      <h2>{{ site.issue_section_title }}</h2>
      <p>{{ site.issue_note }}</p>
    </div>

    {% if recentEssays.length > 0 %}
    <ul class="index">
      {% for essay in recentEssays %}
      <li>
        <h3><a href="{{ essay.url | url }}">{{ essay.data.title }}</a></h3>
        <p class="byline"><a href="{{ ('/authors/' + (essay.data.author | slugify) + '/') | url }}">{{ essay.data.author }}</a></p>
        <p class="dek">{{ essay.data.summary }}</p>
      </li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="empty">No essays published yet. Once one is added through the editor panel at <code>/admin</code>, it will appear here automatically.</p>
    {% endif %}
    <p class="archive-pointer">Looking for something older? <a href="{{ '/archive/' | url }}">Browse the archive</a> — essays move here automatically two months after publishing.</p>
  </div>
</section>

<section id="review">
  <div class="wrap sheet">
    <div class="sec-head">
      <h2>{{ site.review_section_title }}</h2>
      <p>{{ site.review_section_note }}</p>
    </div>
    <ol class="flow">
      {% for step in site.review_steps %}
      <li><div><h3>{{ step.title }}</h3><p>{{ step.text }}</p></div></li>
      {% endfor %}
    </ol>
  </div>
</section>

<section id="board">
  <div class="wrap sheet">
    <div class="sec-head">
      <h2>{{ site.board_section_title }}</h2>
      <p>{{ site.board_section_note }}</p>
    </div>
    <div class="board">
      {% for member in site.board %}
      <div><strong>{{ member.name }}</strong><span>{{ member.role }}</span></div>
      {% endfor %}
    </div>
  </div>
</section>

<section id="submit">
  <div class="wrap sheet">
    <div class="sec-head">
      <h2>{{ site.submit_section_title }}</h2>
      <p>{{ site.submit_section_note }}</p>
    </div>
    <div class="submit-grid">
      <div>
        <p>{{ site.submit_intro_1 }}</p>
        <p>{{ site.submit_intro_2 }}</p>
        <a class="cta" href="#">{{ site.submit_cta_label }}</a>
      </div>
      <div>
        <ul class="specs">
          {% for spec in site.submit_specs %}
          <li><b>{{ spec.label }}</b> {{ spec.value }}</li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>

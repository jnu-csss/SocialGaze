<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{% if title %}{{ title }} — The Social Gaze{% else %}The Social Gaze — a student journal of sociology{% endif %}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,300;1,6..72,400&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}">
</head>
<body>

<header class="top">
  <div class="wrap sheet top-in">
    <a class="wordmark" href="{{ '/' | url }}">The Social <span>Gaze</span></a>
    <nav>
      <a href="{{ '/#issue' | url }}">{{ site.nav_issue_label }}</a>
      <a href="{{ '/#review' | url }}">{{ site.nav_review_label }}</a>
      <a href="{{ '/#board' | url }}">{{ site.nav_board_label }}</a>
      <a href="{{ '/#submit' | url }}">{{ site.nav_submit_label }}</a>
      <a href="{{ '/archive/' | url }}">Archive</a>
    </nav>
  </div>
</header>

{{ content | safe }}

<script src="{{ '/assets/js/search.js' | url }}" defer></script>

<footer>
  <div class="wrap sheet">
    <p>{{ site.footer_line_1 }}</p>
    <p>Authors retain copyright. Essays may be shared with attribution. Write to the editors at {{ site.contact_email }}.</p>
  </div>
</footer>

</body>
</html>
